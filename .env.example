PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Production site origin used for canonical URLs, Open Graph, JSON-LD, and sitemaps.
# Set this in Vercel to your live domain, including https, with no trailing slash.
PUBLIC_SITE_URL=https://www.your-domain.com

# Optional. POST this URL after a catalog publish so a static rebuild can run.
# Create it in Vercel: Project → Settings → Git → Deploy Hooks
# Not required for this project because catalog pages are server-rendered.
VERCEL_DEPLOY_HOOK_URL=

# Product scraper (local admin only). Do not set these on Vercel unless the scraper is hosted.
# Never prefix these with PUBLIC_.
SCRAPER_SERVICE_URL=http://127.0.0.1:8787
SCRAPER_API_KEY=

# Product processor (local admin only). Do not set these on Vercel unless the processor is hosted.
# Never prefix these with PUBLIC_.
PROCESSOR_SERVICE_URL=http://127.0.0.1:8788
PROCESSOR_API_KEY=
