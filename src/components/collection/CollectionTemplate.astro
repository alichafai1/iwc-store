---
import type { Product } from '../../types/product';
import type { CollectionPageData } from '../../types/collection';
import { getCollectionImage } from '../../data/collection-media';
import FAQSection from '../home/FAQSection.astro';
import CollectionCarousel from '../home/CollectionCarousel.astro';
import CustomerReviewsSection from '../home/CustomerReviewsSection.astro';
import TrustSection from '../layout/TrustSection.astro';
import Breadcrumb from '../ui/Breadcrumb.astro';
import Container from '../ui/Container.astro';
import ProductCard from '../ui/ProductCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedStoreCollectionCards } from '../../lib/catalog';
import { isMerchandisingCollectionSlug } from '../../data/collections';
import { absoluteUrl, breadcrumbJsonLd, collectionPageJsonLd, defaultJsonLd, faqPageJsonLd, itemListJsonLd } from '../../lib/seo';

interface Props {
  page: CollectionPageData;
  products: Product[];
}

const { page, products } = Astro.props;
const {
  collection,
  heading,
  path,
  intro,
  metaTitle,
  metaDescription,
  image,
  imageAlt,
  overviewParagraphs,
  historyParagraphs,
  modelsGuideHeading,
  modelsGuideParagraphs,
  buyingGuideParagraphs,
  comparisonParagraphs,
  comparisonItems,
  features,
  faqs,
  faqHeading,
  whyChooseHeading,
  whyChooseParagraphs,
  relatedIntro,
  relatedLinks,
  popularModels,
  internalLinks,
  otherCollections,
} = page;
const productsBySlug = new Map(products.map((product) => [product.slug, product]));
const popularProducts = popularModels.flatMap((model) => {
  const product = productsBySlug.get(model.slug);
  return product ? [product] : [];
});
const collectionCards = await getPublishedStoreCollectionCards();
const cardsBySlug = new Map(collectionCards.map((card) => [card.slug, card]));
const exploreCollections = otherCollections
  .filter((item) => !isMerchandisingCollectionSlug(item.slug))
  .map((item) => {
  const card = cardsBySlug.get(item.slug);
  return {
    name: item.name,
    href: `/collections/${item.slug}/`,
    image: card?.image ?? getCollectionImage(item.slug),
    imageAlt: card?.imageAlt,
  };
});
const pageUrl = absoluteUrl(path);
const breadcrumbId = `${pageUrl}#breadcrumb`;
const itemListId = `${pageUrl}#itemlist`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Collections', path: '/collections/' },
  { name: collection.name, path },
];
const jsonLd = [
  defaultJsonLd(),
  collectionPageJsonLd({
    name: heading,
    description: metaDescription,
    path,
    image: image ?? undefined,
    breadcrumbId,
    mainEntityId: products.length > 0 ? itemListId : undefined,
  }),
  breadcrumbJsonLd(breadcrumbs, { id: breadcrumbId }),
];

if (products.length > 0) {
  jsonLd.push(
    itemListJsonLd({
      id: itemListId,
      items: products.map((product) => ({
        name: product.title,
        path: `/products/${product.slug}/`,
      })),
    }),
  );
}

if (faqs.length > 0) {
  jsonLd.push(faqPageJsonLd(faqs));
}
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath={path}
  ogImage={image ?? undefined}
  jsonLd={jsonLd}
>
  <section class="collection-header">
    <Container>
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Collections', href: '/collections/' },
          { label: collection.name },
        ]}
      />
      <div class:list={['collection-header__layout', image && 'collection-header__layout--with-cover']}>
        {
          image && (
            <div class="collection-header__cover">
              <img src={image} alt={imageAlt} width="800" height="1000" />
            </div>
          )
        }
        <div class="collection-header__copy">
          <h1>{heading}</h1>
          {intro && <p>{intro}</p>}
        </div>
      </div>
    </Container>
  </section>

  <section class="section collection-products" aria-labelledby="collection-products-heading">
    <Container>
      <h2 id="collection-products-heading" class="visually-hidden">
        {heading} in this collection
      </h2>

      {
        products.length > 0 ? (
          <div class="collection-grid">
            {products.map((product) => <ProductCard product={product} />)}
          </div>
        ) : (
          <p class="collection-empty">No published products are listed in this collection yet.</p>
        )
      }
    </Container>
  </section>

  {
    overviewParagraphs.length > 0 && (
      <section class="section section--muted collection-seo" aria-labelledby="collection-overview-heading">
        <Container size="md">
          <h2 id="collection-overview-heading">Overview</h2>
          {overviewParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </Container>
      </section>
    )
  }

  <CustomerReviewsSection headingId="collection-customer-reviews-heading" />

  {
    historyParagraphs.length > 0 && (
      <section class="section collection-seo" aria-labelledby="collection-history-heading">
        <Container size="md">
          <h2 id="collection-history-heading">History</h2>
          {historyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </Container>
      </section>
    )
  }

  {
    modelsGuideParagraphs.length > 0 && (
      <section class="section section--muted collection-seo" aria-labelledby="collection-models-guide-heading">
        <Container size="md">
          <h2 id="collection-models-guide-heading">{modelsGuideHeading ?? 'Models guide'}</h2>
          {modelsGuideParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </Container>
      </section>
    )
  }

  {
    features.length > 0 && (
      <section class="section collection-features" aria-labelledby="collection-features-heading">
        <Container size="md">
          <h2 id="collection-features-heading">Features</h2>
          <ul>
            {features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  {
    popularProducts.length > 0 && (
      <section class="section collection-models" aria-labelledby="collection-models-heading">
        <Container>
          <h2 id="collection-models-heading">Popular models</h2>
          <div class="collection-grid">
            {popularProducts.map((product) => <ProductCard product={product} />)}
          </div>
        </Container>
      </section>
    )
  }

  {
    buyingGuideParagraphs.length > 0 && (
      <section class="section section--muted collection-seo" aria-labelledby="collection-guide-heading">
        <Container size="md">
          <h2 id="collection-guide-heading">Buying guide</h2>
          {buyingGuideParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </Container>
      </section>
    )
  }

  {
    (comparisonParagraphs.length > 0 || comparisonItems.length > 0) && (
      <section class="section collection-seo" aria-labelledby="collection-comparison-heading">
        <Container size="md">
          <h2 id="collection-comparison-heading">Comparison</h2>
          {comparisonParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          {comparisonItems.length > 0 && (
            <ul class="collection-seo__links">
              {comparisonItems.map((item) => (
                <li>
                  <a href={item.href}>{item.name}</a>
                  {item.body && <p>{item.body}</p>}
                </li>
              ))}
            </ul>
          )}
        </Container>
      </section>
    )
  }

  {
    (relatedIntro || relatedLinks.length > 0) && (
      <section class="section collection-seo" aria-labelledby="collection-related-heading">
        <Container size="md">
          <h2 id="collection-related-heading">Related collections</h2>
          {relatedIntro && <p>{relatedIntro}</p>}
          {relatedLinks.length > 0 && (
            <ul class="collection-seo__links">
              {relatedLinks.map((item) => (
                <li>
                  {item.context && <p>{item.context}</p>}
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          )}
        </Container>
      </section>
    )
  }

  {
    whyChooseParagraphs.length > 0 && (
      <section class="section section--muted collection-seo" aria-labelledby="collection-why-choose-heading">
        <Container size="md">
          <h2 id="collection-why-choose-heading">{whyChooseHeading ?? 'Why choose this collection'}</h2>
          {whyChooseParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </Container>
      </section>
    )
  }

  {faqs.length > 0 && <FAQSection items={faqs} title={faqHeading ?? undefined} headingId="collection-faq-heading" />}

  {
    internalLinks.length > 0 && (
      <section class="section collection-seo" aria-labelledby="collection-internal-heading">
        <Container size="md">
          <h2 id="collection-internal-heading">Related links</h2>
          <ul class="collection-seo__links">
            {internalLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </Container>
      </section>
    )
  }

  {
    exploreCollections.length > 0 && (
      <section class="section collection-links" aria-labelledby="other-collections-heading">
        <Container>
          <h2 id="other-collections-heading">Explore Other Collections</h2>
          <CollectionCarousel collections={exploreCollections} />
        </Container>
      </section>
    )
  }

  <TrustSection />
</BaseLayout>

<style>
  .collection-header {
    padding-top: var(--space-6);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .collection-header :global(.breadcrumb) {
    margin-bottom: var(--space-5);
  }

  .collection-header__layout--with-cover {
    display: grid;
    gap: var(--space-5);
  }

  .collection-header__cover {
    max-width: 10rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #f6f6f6;
  }

  .collection-header__cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .collection-header h1 {
    margin: 0 0 var(--space-4);
    font-size: var(--font-size-xl);
  }

  .collection-header p {
    max-width: 38rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  .collection-products {
    padding-top: var(--space-6);
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .collection-seo h2,
  .collection-features h2,
  .collection-models h2 {
    margin-bottom: var(--space-5);
    font-size: var(--font-size-xl);
  }

  .collection-empty {
    margin: 0;
    color: var(--color-text-muted);
  }

  .collection-seo p,
  .collection-features li,
  .collection-seo a {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .collection-features ul,
  .collection-seo__links {
    margin: 0;
    padding-left: 1.1rem;
  }

  .collection-features li + li,
  .collection-seo__links li + li {
    margin-top: var(--space-3);
  }

  .collection-seo__links p {
    margin: 0 0 var(--space-2);
  }

  .collection-seo a {
    color: inherit;
  }

  .collection-links {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-8);
  }

  .collection-links h2 {
    margin-bottom: var(--space-5);
    font-size: var(--font-size-xl);
  }

  @media (min-width: 48em) {
    .collection-header {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .collection-header__layout--with-cover {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-6);
    }

    .collection-header h1 {
      font-size: var(--font-size-2xl);
    }

    .collection-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .collection-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .collection-seo h2,
    .collection-features h2,
    .collection-models h2,
    .collection-links h2 {
      font-size: var(--font-size-2xl);
    }
  }
</style>
