---
const features = [
  {
    icon: 'original' as const,
    title: 'Same as Original',
    text: 'Superclone finishing that follows the original case, dial, and proportions.',
  },
  {
    icon: 'warranty' as const,
    title: '1-Year Guarantee',
    text: 'Every watch ships with a 1-year movement warranty.',
  },
  {
    icon: 'support' as const,
    title: 'Live Support 24h',
    text: 'Questions answered on WhatsApp, any time.',
  },
  {
    icon: 'shipping' as const,
    title: 'Worldwide Shipping',
    text: 'Tax-free, discreet packaging, and tracking on every order.',
  },
];
---

<section class="home-features" aria-labelledby="home-features-heading">
  <h2 id="home-features-heading" class="visually-hidden">Product features</h2>
  <div class="container">
    <ul class="home-features__grid">
      {
        features.map((feature) => (
          <li class="home-features__card">
            <span class="home-features__icon" aria-hidden="true">
              {feature.icon === 'original' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8.25"></circle>
                  <path d="M12 7.5v4.6l2.8 1.6"></path>
                  <path d="M9 3.6h6"></path>
                  <path d="M9 20.4h6"></path>
                </svg>
              ) : null}
              {feature.icon === 'warranty' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3.2 19.2 6v6.2c0 4.2-3 6.9-7.2 8.4-4.2-1.5-7.2-4.2-7.2-8.4V6Z"></path>
                  <path d="m8.6 12 2.3 2.3 4.5-4.6"></path>
                </svg>
              ) : null}
              {feature.icon === 'support' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.8 12a7.2 7.2 0 0 1 14.4 0"></path>
                  <path d="M4.8 12v3.4A2.2 2.2 0 0 0 7 17.6h.6"></path>
                  <path d="M19.2 12v3.4a2.2 2.2 0 0 1-2.2 2.2h-.6"></path>
                  <path d="M15.4 19.4c0 1.1-1.5 2-3.4 2s-3.4-.9-3.4-2"></path>
                </svg>
              ) : null}
              {feature.icon === 'shipping' ? (
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3.6 7.4h10.6v9.2H8.2"></path>
                  <path d="M14.2 11h4l2.2 3v2.6h-2.4"></path>
                  <circle cx="6.8" cy="16.8" r="1.7"></circle>
                  <circle cx="16.6" cy="16.8" r="1.7"></circle>
                </svg>
              ) : null}
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:inline>
  .home-features {
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
    background: var(--color-bg);
  }

  .home-features__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-features__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
    padding: 1.25rem 0.85rem 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: #ffffff;
    text-align: center;
  }

  .home-features__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-accent-dark);
  }

  .home-features h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .home-features p {
    margin: 0;
    max-width: 16rem;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  @media (min-width: 64em) {
    .home-features {
      padding-top: var(--space-8);
      padding-bottom: var(--space-5);
    }

    .home-features__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }

    .home-features__card {
      padding: 1.6rem 1.15rem 1.45rem;
      border-color: transparent;
      box-shadow: 0 10px 28px rgb(17 17 11 / 4%);
    }

    .home-features__icon {
      width: 2.15rem;
      height: 2.15rem;
      margin-bottom: 0.9rem;
    }

    .home-features h3 {
      font-size: 0.78rem;
    }

    .home-features p {
      font-size: 0.82rem;
    }
  }
</style>
