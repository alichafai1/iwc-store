---
import Button from '../ui/Button.astro';
import { getPublishedSiteImage, HOMEPAGE_HERO_SLOT } from '../../lib/catalog';

const hero = await getPublishedSiteImage(HOMEPAGE_HERO_SLOT);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Discover</p>
      <h1 id="hero-heading">Our IWC replica watches.</h1>
      <p class="hero__text">
        Explore the Pilot, Portugieser, Portofino, Aquatimer, and Ingenieur collections. Each published listing shows the line, the finishing, and the Top 1:1 Clone grade.
      </p>
      <div class="hero__actions">
        <Button href="/collections/">Discover the collections</Button>
        <Button href="/guides/" variant="ghost">Read the guides</Button>
      </div>
    </div>
    {
      hero && (
        <div class="hero__media">
          <img
            src={hero.src}
            alt={hero.alt}
            width={hero.width ?? 1024}
            height={hero.height ?? 575}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero h1 {
    margin-bottom: var(--space-4);
  }

  .hero__text {
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__media {
    aspect-ratio: 1024 / 575;
    overflow: hidden;
    background: transparent;
  }

  .hero__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  @media (min-width: 64em) {
    .hero__inner {
      grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.15fr);
      align-items: center;
      gap: var(--space-10);
      min-height: 36rem;
      padding-block: var(--space-8);
    }
  }

  @media (min-width: 80em) {
    .hero__inner {
      min-height: 40rem;
    }
  }
</style>
