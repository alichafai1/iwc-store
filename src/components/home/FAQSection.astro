---
import type { FaqItem } from '../../types/faq';
import { faqAnswerParts } from '../../lib/faq-text';
import Container from '../ui/Container.astro';

interface Props {
  items: FaqItem[];
  title?: string;
  headingId?: string;
}

const {
  items,
  title = 'Frequently Asked Questions',
  headingId = 'faq-heading',
} = Astro.props;
---

<section class="section faq" aria-labelledby={headingId}>
  <Container>
    <h2 id={headingId}>{title}</h2>
    <div class="faq__list">
      {
        items.map((item) => (
          <details class="faq__item">
            <summary>
              <h3>{item.question}</h3>
            </summary>
            <p>
              {
                faqAnswerParts(item.answer).map((part) =>
                  part.type === 'link' ? <a href={part.href}>{part.label}</a> : part.value,
                )
              }
            </p>
          </details>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .faq h2 {
    margin: 0 0 var(--space-6);
    font-size: var(--font-size-xl);
  }

  .faq__list {
    border-top: 1px solid var(--color-border);
  }

  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    flex: 0 0 auto;
    color: var(--color-accent-dark);
    content: "+";
    font-size: var(--font-size-lg);
    line-height: 1;
  }

  .faq__item[open] summary::after {
    content: "–";
  }

  .faq__item h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .faq__item p {
    margin: 0;
    padding-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    max-width: 42rem;
  }

  .faq__item p :global(a) {
    color: var(--color-text);
    text-underline-offset: 0.18em;
  }

  .faq__item p :global(a:hover) {
    color: var(--color-accent-dark);
  }

  @media (min-width: 64em) {
    .faq h2 {
      font-size: var(--font-size-2xl);
    }
  }
</style>
