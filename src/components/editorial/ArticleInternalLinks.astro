---
import type { ArticleInternalLinks } from '../../types/article';

interface Props {
  links: ArticleInternalLinks;
}

const { links } = Astro.props;
const groups = [
  { title: 'Products', items: links.products ?? [] },
  { title: 'Collections', items: links.collections ?? [] },
  { title: 'Guides', items: links.guides ?? [] },
  { title: 'Blog posts', items: links.posts ?? [] },
].filter((group) => group.items.length > 0);
---

{
  groups.length > 0 && (
    <nav class="article-links" aria-labelledby="article-links-heading">
      <h2 id="article-links-heading">Related links</h2>
      <div class="article-links__grid">
        {groups.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
  )
}

<style>
  .article-links {
    margin: var(--space-8) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .article-links h2 {
    margin: 0 0 var(--space-5);
    font-size: var(--font-size-xl);
  }

  .article-links__grid {
    display: grid;
    gap: var(--space-5);
  }

  .article-links h3 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 500;
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  .article-links ul {
    display: grid;
    gap: var(--space-2);
    list-style: none;
  }

  .article-links a {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .article-links a:hover {
    color: var(--color-accent-dark);
  }

  @media (min-width: 48em) {
    .article-links__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
