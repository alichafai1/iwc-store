---
import { Image } from 'astro:assets';
import type { Author } from '../../types/author';

interface Props {
  author: Author;
}

const { author } = Astro.props;
const href = `/authors/${author.slug}/`;
---

<section class="author-box" aria-labelledby="author-box-heading">
  <h2 id="author-box-heading" class="visually-hidden">Author</h2>
  <a class="author-box__media" href={href}>
    <Image src={author.image} alt={author.imageAlt} width={160} height={160} loading="lazy" />
  </a>
  <div>
    <p class="author-box__name">
      <a href={href}>{author.name}</a>
    </p>
    {author.role ? <p class="author-box__role">{author.role}</p> : null}
    <p class="author-box__bio">{author.bio}</p>
    <a class="author-box__link" href={href}>View author page</a>
  </div>
</section>

<style>
  .author-box {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .author-box__media {
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-muted);
  }

  .author-box__name {
    margin: 0 0 var(--space-1);
    color: var(--color-text);
    font-weight: 600;
  }

  .author-box__name a,
  .author-box__link {
    text-decoration: none;
  }

  .author-box__role,
  .author-box__bio {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .author-box__link {
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  @media (min-width: 48em) {
    .author-box {
      grid-template-columns: 4.5rem 1fr;
      align-items: start;
      gap: var(--space-5);
    }
  }
</style>
