---
interface InternalLinkRow {
  label: string;
  href: string;
}

interface Props {
  rows?: InternalLinkRow[];
}

const { rows = [] } = Astro.props;
const items = rows.length > 0 ? rows : [{ label: '', href: '' }];
---

<div data-internal-link-editor>
  <div class="admin-row-list" data-internal-link-list>
    {
      items.map((row) => (
        <div class="admin-row" data-internal-link-row>
          <label class="admin-field">
            <span>Anchor text</span>
            <input type="text" name="internal_link_labels" value={row.label} />
          </label>
          <label class="admin-field">
            <span>Internal path</span>
            <input type="text" name="internal_link_hrefs" value={row.href} placeholder="/collections/pilots/" />
          </label>
          <div class="admin-row__controls">
            <button class="btn btn--ghost" type="button" data-row-up>Up</button>
            <button class="btn btn--ghost" type="button" data-row-down>Down</button>
            <button class="btn btn--ghost" type="button" data-row-remove>Remove</button>
          </div>
        </div>
      ))
    }
  </div>
  <button class="btn btn--ghost" type="button" data-internal-link-add>Add internal link</button>
</div>

<template id="internal-link-row-template">
  <div class="admin-row" data-internal-link-row>
    <label class="admin-field"><span>Anchor text</span><input type="text" name="internal_link_labels" /></label>
    <label class="admin-field">
      <span>Internal path</span>
      <input type="text" name="internal_link_hrefs" placeholder="/collections/pilots/" />
    </label>
    <div class="admin-row__controls">
      <button class="btn btn--ghost" type="button" data-row-up>Up</button>
      <button class="btn btn--ghost" type="button" data-row-down>Down</button>
      <button class="btn btn--ghost" type="button" data-row-remove>Remove</button>
    </div>
  </div>
</template>

<script>
  const root = document.querySelector('[data-internal-link-editor]');
  const list = root?.querySelector('[data-internal-link-list]');
  const template = document.getElementById('internal-link-row-template');

  root?.querySelector('[data-internal-link-add]')?.addEventListener('click', () => {
    if (!(template instanceof HTMLTemplateElement)) {
      return;
    }
    const row = template.content.firstElementChild?.cloneNode(true);
    if (row) {
      list?.append(row);
    }
  });

  root?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }
    const row = target.closest('[data-internal-link-row]');
    if (!row) {
      return;
    }
    if (target.closest('[data-row-up]')) {
      row.previousElementSibling?.before(row);
    }
    if (target.closest('[data-row-down]')) {
      row.nextElementSibling?.after(row);
    }
    if (target.closest('[data-row-remove]')) {
      row.remove();
    }
  });
</script>
