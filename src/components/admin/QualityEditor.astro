---
import type { ProductQualityRecord } from '../../lib/admin/products';
import { DEFAULT_QUALITY } from '../../lib/qualities';

interface Props {
  qualities?: ProductQualityRecord[];
}

const { qualities = [] } = Astro.props;
const row = qualities.find((item) => item.quality === DEFAULT_QUALITY) ?? qualities[0];
---

<p class="admin-help">
  These prices belong to the fixed {DEFAULT_QUALITY} quality. Price is required to publish. Compare-at price is
  optional.
</p>

<input type="hidden" name="quality_names" value={DEFAULT_QUALITY} />
<div class="admin-grid admin-grid--2">
  <label class="admin-field">
    <span>Price</span>
    <input type="number" name="quality_prices" min="0" step="0.01" value={row?.price ?? ''} />
  </label>
  <label class="admin-field">
    <span>Compare-at Price</span>
    <input type="number" name="quality_compares" min="0" step="0.01" value={row?.compare_at_price ?? ''} />
  </label>
</div>
