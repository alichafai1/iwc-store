---
import type { ProductSpecRecord } from '../../lib/admin/products';

interface Props {
  specs?: ProductSpecRecord[];
}

const { specs = [] } = Astro.props;
const rows =
  specs.length > 0
    ? specs
    : [{ id: '', product_id: '', label: '', value: '', position: 0 }];
---

<div data-spec-editor>
  <div class="admin-row-list" data-spec-list>
    {
      rows.map((spec, index) => (
        <div class="admin-row" data-spec-row>
          <div class="admin-grid admin-grid--2">
            <label class="admin-field">
              <span>Label</span>
              <input type="text" name="spec_labels" value={spec.label} />
            </label>
            <label class="admin-field">
              <span>Value</span>
              <input type="text" name="spec_values" value={spec.value} />
            </label>
            <label class="admin-field">
              <span>Position</span>
              <input type="number" name="spec_positions" min="0" step="1" value={spec.position ?? index} />
            </label>
          </div>
          <div class="admin-row__controls">
            <button class="btn btn--ghost" type="button" data-row-up>
              Up
            </button>
            <button class="btn btn--ghost" type="button" data-row-down>
              Down
            </button>
            <button class="btn btn--ghost" type="button" data-row-remove>
              Remove
            </button>
          </div>
        </div>
      ))
    }
  </div>
  <button class="btn btn--ghost" type="button" data-spec-add>Add specification</button>
</div>

<template id="spec-row-template">
  <div class="admin-row" data-spec-row>
    <div class="admin-grid admin-grid--2">
      <label class="admin-field"><span>Label</span><input type="text" name="spec_labels" /></label>
      <label class="admin-field"><span>Value</span><input type="text" name="spec_values" /></label>
      <label class="admin-field"><span>Position</span><input type="number" name="spec_positions" min="0" step="1" /></label>
    </div>
    <div class="admin-row__controls">
      <button class="btn btn--ghost" type="button" data-row-up>Up</button>
      <button class="btn btn--ghost" type="button" data-row-down>Down</button>
      <button class="btn btn--ghost" type="button" data-row-remove>Remove</button>
    </div>
  </div>
</template>

<script>
  const root = document.querySelector('[data-spec-editor]');
  const list = root?.querySelector('[data-spec-list]');
  const template = document.getElementById('spec-row-template');

  root?.querySelector('[data-spec-add]')?.addEventListener('click', () => {
    if (!(template instanceof HTMLTemplateElement)) {
      return;
    }

    const row = template.content.firstElementChild?.cloneNode(true);
    if (row) {
      list?.append(row);
    }
  });

  root?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) {
      return;
    }

    const row = target.closest('[data-spec-row]');
    if (!row) {
      return;
    }

    if (target.closest('[data-row-up]')) {
      row.previousElementSibling?.before(row);
    }

    if (target.closest('[data-row-down]')) {
      row.nextElementSibling?.after(row);
    }

    if (target.closest('[data-row-remove]')) {
      row.remove();
    }
  });
</script>
