---
import { getRelatedArticleCards } from '../lib/content-articles';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const articles = await getRelatedArticleCards(slugs);
---

{
  articles.length > 0 && (
    <section class="related-articles" aria-labelledby="related-articles-heading">
      <h2 id="related-articles-heading">Related articles</h2>
      <div class="related-articles__grid">
        {articles.map((article) => (
          <article class="related-articles__card">
            <a href={article.href}>
              <img src={article.image} alt={article.imageAlt} width="1080" height="1080" loading="lazy" />
              <h3>{article.title}</h3>
              <p>{article.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}
