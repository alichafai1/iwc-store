---
import { getRelatedArticleCards } from '../lib/content-articles';
import { isRemoteMedia } from '../lib/media';
import { ARTICLE_CARD_IMAGE } from '../lib/storage-image';
import OptimizedRemoteImage from './ui/OptimizedRemoteImage.astro';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const articles = await getRelatedArticleCards(slugs);
---

{
  articles.length > 0 && (
    <section class="related-articles" aria-labelledby="related-articles-heading">
      <h2 id="related-articles-heading">Related articles</h2>
      <div class="related-articles__grid">
        {articles.map((article) => (
          <article class="related-articles__card">
            <a href={article.href}>
              {isRemoteMedia(article.image) ? (
                <OptimizedRemoteImage
                  src={article.image}
                  alt={article.imageAlt}
                  widths={ARTICLE_CARD_IMAGE.widths}
                  sizes="(min-width: 64em) 30vw, 100vw"
                  width={ARTICLE_CARD_IMAGE.width}
                  height={ARTICLE_CARD_IMAGE.height}
                  loading="lazy"
                />
              ) : (
                <img src={article.image} alt={article.imageAlt} width="1080" height="1080" loading="lazy" decoding="async" />
              )}
              <h3>{article.title}</h3>
              <p>{article.description}</p>
            </a>
          </article>
        ))}
      </div>
    </section>
  )
}
