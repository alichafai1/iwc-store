---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { isRemoteMedia } from '../../lib/media';
import { COLLECTION_CARD_IMAGE } from '../../lib/storage-image';
import OptimizedRemoteImage from './OptimizedRemoteImage.astro';

interface Props {
  name: string;
  href: string;
  image: ImageMetadata | string;
  imageAlt?: string;
}

const { name, href, image, imageAlt = `${name} collection` } = Astro.props;
const slightZoom = /\/(da-vinci|ingenieur)\/?$/.test(href);
const remoteImage = isRemoteMedia(image) ? image : undefined;
const photoClass = ['collection-card__photo', slightZoom ? 'collection-card__photo--slight-zoom' : '']
  .filter(Boolean)
  .join(' ');
---

<article class="collection-card">
  <a href={href}>
    <div class:list={['media', 'collection-card__media', remoteImage && 'collection-card__media--photo']}>
      {
        remoteImage ? (
          <OptimizedRemoteImage
            class={photoClass}
            src={remoteImage}
            alt={imageAlt}
            widths={COLLECTION_CARD_IMAGE.widths}
            sizes={COLLECTION_CARD_IMAGE.sizes}
            width={COLLECTION_CARD_IMAGE.width}
            height={COLLECTION_CARD_IMAGE.height}
            loading="lazy"
          />
        ) : typeof image !== 'string' ? (
          <Image
            class="collection-card__fallback"
            src={image}
            alt={imageAlt}
            width={800}
            height={1000}
            sizes={COLLECTION_CARD_IMAGE.sizes}
            loading="lazy"
          />
        ) : null
      }
    </div>
    <h3>{name}</h3>
  </a>
</article>

<style>
  .collection-card,
  .collection-card a {
    height: 100%;
  }

  .collection-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.28s ease;
  }

  .collection-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-muted);
    transition: border-color 0.28s ease, box-shadow 0.28s ease;
  }

  .collection-card__media--photo {
    background: #f6f6f6;
  }

  .collection-card__media :global(picture),
  .collection-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform-origin: center center;
    transition: transform 0.4s ease;
  }

  .collection-card__media :global(.collection-card__photo--slight-zoom) {
    transform: scale(1.1);
  }

  .collection-card a:hover,
  .collection-card a:focus-visible {
    transform: translateY(-6px);
  }

  .collection-card a:hover .collection-card__media,
  .collection-card a:focus-visible .collection-card__media {
    border-color: #cfcfcf;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
  }

  .collection-card a:hover .collection-card__media :global(img),
  .collection-card a:hover .collection-card__media :global(picture),
  .collection-card a:focus-visible .collection-card__media :global(img),
  .collection-card a:focus-visible .collection-card__media :global(picture) {
    transform: scale(1.08);
  }

  .collection-card a:hover .collection-card__media :global(.collection-card__photo--slight-zoom),
  .collection-card a:focus-visible .collection-card__media :global(.collection-card__photo--slight-zoom) {
    transform: scale(1.18);
  }

  .collection-card h3 {
    display: block;
    width: 100%;
    margin: var(--space-3) 0 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: color 0.28s ease;
  }

  .collection-card a:hover h3,
  .collection-card a:focus-visible h3 {
    color: var(--color-accent-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-card a,
    .collection-card__media,
    .collection-card__media :global(img),
    .collection-card h3 {
      transition: none;
    }

    .collection-card a:hover,
    .collection-card a:focus-visible {
      transform: none;
    }
  }
</style>
