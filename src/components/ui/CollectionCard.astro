---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  href: string;
  image: ImageMetadata | string;
  imageAlt?: string;
}

const { name, href, image, imageAlt = `${name} collection` } = Astro.props;
const slightZoom = /\/(da-vinci|ingenieur)\/?$/.test(href);
---

<article class="collection-card">
  <a href={href}>
    <div class:list={['media', 'collection-card__media', typeof image === 'string' && 'collection-card__media--photo']}>
      {
        typeof image === 'string' ? (
          <img
            class:list={['collection-card__photo', slightZoom && 'collection-card__photo--slight-zoom']}
            src={image}
            alt={imageAlt}
            width="800"
            height="1000"
            loading="lazy"
          />
        ) : (
          <Image
            class="collection-card__fallback"
            src={image}
            alt={imageAlt}
            width={800}
            height={1000}
            sizes="(min-width: 64em) 25vw, 50vw"
            loading="lazy"
          />
        )
      }
    </div>
    <h3>{name}</h3>
  </a>
</article>

<style>
  .collection-card,
  .collection-card a {
    height: 100%;
  }

  .collection-card a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .collection-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-muted);
  }

  .collection-card__media--photo {
    background: #f6f6f6;
  }

  .collection-card__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .collection-card__media :global(.collection-card__photo--slight-zoom) {
    transform: scale(1.1);
    transform-origin: center center;
  }

  .collection-card h3 {
    display: flex;
    align-items: flex-start;
    min-height: 2.75em;
    margin: var(--space-3) 0 0;
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
</style>
