---
import type { MediaItem } from '../../types/media';

interface Props {
  items: MediaItem[];
}

const { items } = Astro.props;
const copies = [false, true] as const;
---

<div class="gallery" data-review-marquee>
  <div class="gallery__track">
    {
      copies.map((duplicate) => (
        <ul class="gallery__group" aria-hidden={duplicate ? 'true' : undefined}>
          {items.map((item) => (
            <li>
              <figure class="gallery__frame">
                <img
                  src={item.src}
                  alt={duplicate ? '' : item.alt}
                  width="710"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-review-marquee]').forEach((gallery) => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gallery.setAttribute('data-static', '');
        return;
      }

      const observer = new IntersectionObserver(
        ([entry]) => {
          gallery.toggleAttribute('data-paused', !entry.isIntersecting);
        },
        { threshold: 0.12 },
      );
      observer.observe(gallery);
    });
  })();
</script>

<style>
  .gallery {
    --gallery-gap: var(--space-4);
    --gallery-card: 16.5rem;
    overflow: hidden;
  }

  .gallery__track {
    display: flex;
    width: max-content;
    animation: gallery-marquee 56s linear 1.8s infinite;
  }

  .gallery[data-paused] .gallery__track {
    animation-play-state: paused;
  }

  .gallery__group {
    display: flex;
    align-items: stretch;
    gap: var(--gallery-gap);
    margin: 0;
    padding: 0 var(--gallery-gap) 0 0;
    list-style: none;
  }

  .gallery__group li {
    flex: 0 0 var(--gallery-card);
    width: var(--gallery-card);
  }

  .gallery__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    margin: 0;
    overflow: hidden;
    background: transparent;
  }

  .gallery__frame img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
  }

  @media (min-width: 48em) {
    .gallery {
      --gallery-card: 18rem;
    }
  }

  @keyframes gallery-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }

    .gallery__track {
      animation: none;
    }

    .gallery__group:last-child {
      display: none;
    }

    .gallery__group li {
      scroll-snap-align: start;
    }
  }
</style>
