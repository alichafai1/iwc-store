---
import { Image } from 'astro:assets';
import { formatPrice } from '../../lib/format';
import { isRemoteMedia } from '../../lib/media';
import { PRODUCT_CARD_IMAGE } from '../../lib/storage-image';
import type { Product } from '../../types/product';
import OptimizedRemoteImage from './OptimizedRemoteImage.astro';

interface Props {
  product: Product;
  showSku?: boolean;
  ctaLabel?: string;
}

const { product, showSku = false, ctaLabel = 'Shop Now' } = Astro.props;
const href = `/products/${product.slug}/`;
const compareAtPrice = product.compareAtPrice;
const showCompareAt = typeof compareAtPrice === 'number' && compareAtPrice > product.price;
const ratingLabel =
  product.reviewCount > 0
    ? `Rated ${product.rating} out of 5 from ${product.reviewCount} reviews`
    : 'No reviews yet';
---

<article class="product-card">
  <a class="product-card__main" href={href}>
    <div class="product-card__media product-media">
      {
        product.image && isRemoteMedia(product.image) ? (
          <OptimizedRemoteImage
            src={product.image}
            alt={product.imageAlt}
            widths={PRODUCT_CARD_IMAGE.widths}
            sizes={PRODUCT_CARD_IMAGE.sizes}
            width={PRODUCT_CARD_IMAGE.width}
            height={PRODUCT_CARD_IMAGE.height}
            loading="lazy"
          />
        ) : product.image ? (
          <Image
            src={product.image}
            alt={product.imageAlt}
            width={800}
            height={800}
            sizes="(min-width: 64em) 25vw, 50vw"
            loading="lazy"
          />
        ) : (
          <span class="product-media-empty" aria-hidden="true" />
        )
      }
    </div>
    <div class="product-card__body">
      <h3 class="product-card__title">{product.title}</h3>
      {
        showSku && product.sku && (
          <p class="product-card__sku">Ref. {product.sku}</p>
        )
      }
      <p class="product-card__reviews" aria-label={ratingLabel}>
        <span class="product-card__stars" aria-hidden="true">
          {[0, 1, 2, 3, 4].map(() => (
            <svg class="product-card__star" viewBox="0 0 24 24" focusable="false">
              <path d="M12 2.6l2.7 5.6 6.2.8-4.5 4.3 1.2 6.1L12 16.8 6.4 19.4l1.2-6.1-4.5-4.3 6.2-.8L12 2.6z" />
            </svg>
          ))}
        </span>
        <span class="product-card__count">({product.reviewCount})</span>
      </p>
      <p class="product-card__price">
        <span class="product-card__price-current">{formatPrice(product.price)}</span>
        {
          showCompareAt && (
            <s class="product-card__price-compare">{formatPrice(compareAtPrice)}</s>
          )
        }
      </p>
    </div>
  </a>
  <a class="product-card__cta" href={href}>{ctaLabel}</a>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    cursor: pointer;
  }

  .product-card__main {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .product-card__main:hover {
    color: inherit;
  }

  .product-card__media {
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    transition:
      transform 250ms ease,
      box-shadow 250ms ease;
  }

  .product-media-empty {
    width: 100%;
    height: 100%;
  }

  .product-card:active .product-card__media {
    transform: translateY(1px);
    box-shadow: 0 4px 10px rgb(17 17 11 / 6%);
  }

  .product-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding-top: var(--space-4);
  }

  .product-card__sku {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-card__title {
    display: -webkit-box;
    min-height: calc(var(--line-height-tight) * 2em);
    margin: 0;
    overflow: hidden;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    font-weight: 700;
    line-height: var(--line-height-tight);
    text-align: left;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .product-card__reviews {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: var(--space-2) 0 0;
    line-height: 1;
    font-size: var(--font-size-xs);
  }

  .product-card__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    color: var(--color-accent);
  }

  .product-card__star {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .product-card__count {
    color: var(--color-text-muted);
  }

  .product-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    margin: var(--space-3) 0 0;
    font-family: var(--font-sans);
  }

  .product-card__price-current {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .product-card__price-compare {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 400;
    text-decoration: line-through;
  }

  .product-card__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.4rem;
    margin-top: var(--space-4);
    padding: 0.55rem 1rem;
    border-radius: 8px;
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-sans);
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 200ms ease;
  }

  .product-card__cta:hover,
  .product-card__cta:focus-visible {
    background: var(--color-accent);
    color: var(--color-text);
  }

  .product-card__cta:active {
    background: var(--color-accent-dark);
    color: var(--color-bg);
    transform: translateY(1px);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__media {
      transform: translateY(-3px);
      box-shadow: 0 8px 18px rgb(17 17 11 / 8%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__media,
    .product-card__cta {
      transition: none;
    }

    .product-card:hover .product-card__media,
    .product-card:active .product-card__media,
    .product-card__cta:active {
      transform: none;
      box-shadow: none;
    }
  }
</style>
