---
import { headerCollectionLinks, headerNav } from '../../data/navigation';
import { siteConfig } from '../../lib/site';
import Icon from '../ui/Icon.astro';
---

<header class="site-header">
  <div class="site-header__announce">
    <div class="container site-header__announce-inner">
      <ul class="site-header__announce-list">
        <li>Tax Free (Worldwide Shipping)</li>
        <li>QC Photos Before Dispatch</li>
        <li>1-Year Movement Warranty</li>
      </ul>
      <a class="site-header__whatsapp" href="/contact/">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        WhatsApp 24/7
      </a>
    </div>
  </div>

  <div class="site-header__bar">
    <div class="container site-header__inner">
      <input id="nav-open" class="nav-checkbox" type="checkbox" aria-label="Menu" />

      <label class="icon-btn site-header__menu" for="nav-open">
        <Icon name="menu" />
      </label>

      <a class="site-header__logo" href="/">{siteConfig.name}</a>

      <nav class="site-header__desktop" aria-label="Primary">
        <ul>
          {
            headerNav.map((item) =>
              item.label === 'Collections' ? (
                <li class="has-dropdown">
                  <a href={item.href} aria-haspopup="true">
                    {item.label}
                  </a>
                  <ul class="nav-dropdown" aria-label="Collections">
                    {headerCollectionLinks.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              )
            )
          }
        </ul>
      </nav>

      <nav class="site-header__utilities" aria-label="Account">
        <ul>
          <li>
            <button class="icon-btn" type="button" aria-label="Search">
              <Icon name="search" />
            </button>
          </li>
          <li class="site-header__desktop-only">
            <button class="icon-btn" type="button" aria-label="Account">
              <Icon name="account" />
            </button>
          </li>
          <li class="site-header__desktop-only">
            <button class="icon-btn" type="button" aria-label="Wishlist">
              <Icon name="wishlist" />
            </button>
          </li>
          <li>
            <a class="icon-btn" href="/checkout/" aria-label="Cart">
              <Icon name="cart" />
            </a>
          </li>
        </ul>
      </nav>

      <label class="site-header__backdrop" for="nav-open" aria-hidden="true"></label>

      <div class="site-header__drawer">
        <div class="site-header__drawer-top">
          <p class="site-header__logo">{siteConfig.name}</p>
          <label class="icon-btn" for="nav-open" aria-hidden="true">
            <Icon name="close" />
          </label>
        </div>
        <nav aria-label="Mobile">
          <ul>
            {
              headerNav.map((item) =>
                item.label === 'Collections' ? (
                  <li>
                    <details class="mobile-collections">
                      <summary>{item.label}</summary>
                      <ul>
                        {headerCollectionLinks.map((link) => (
                          <li>
                            <a href={link.href}>{link.label}</a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                )
              )
            }
            <li>
              <button type="button">Account</button>
            </li>
            <li>
              <button type="button">Wishlist</button>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-bg);
  }

  .site-header__announce {
    background: #000000;
    color: #e8e4dc;
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .site-header__announce-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    min-height: 2.35rem;
  }

  .site-header__announce-list {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0.55rem 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
    white-space: nowrap;
  }

  .site-header__announce-list::-webkit-scrollbar {
    display: none;
  }

  .site-header__announce-list li + li::before {
    display: inline-block;
    margin: 0 0.85rem;
    color: #cfc9bf;
    content: "|";
    font-weight: 400;
  }

  .site-header__whatsapp {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__whatsapp:hover,
  .site-header__whatsapp:focus-visible {
    color: #d4b56e;
  }

  .site-header__whatsapp svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .site-header__bar {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 2.75rem 1fr auto;
    align-items: center;
    min-height: var(--header-height);
  }

  .nav-checkbox {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .nav-checkbox:focus-visible + .site-header__menu {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .site-header__logo {
    justify-self: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-header__desktop {
    display: none;
  }

  .site-header__utilities ul {
    display: flex;
    align-items: center;
    list-style: none;
  }

  .site-header__desktop-only {
    display: none;
  }

  .site-header__backdrop {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgb(17 17 17 / 0.35);
    opacity: 0;
    pointer-events: none;
  }

  .site-header__drawer {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: min(22rem, 88vw);
    padding: var(--space-5);
    background: var(--color-bg);
    transform: translateX(-105%);
  }

  .site-header__drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .site-header__drawer nav ul {
    display: grid;
    gap: var(--space-4);
    list-style: none;
  }

  .site-header__drawer a,
  .site-header__drawer button,
  .site-header__drawer summary {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-nav);
    text-align: left;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mobile-collections summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .mobile-collections summary::-webkit-details-marker {
    display: none;
  }

  .mobile-collections summary::after {
    color: var(--color-accent-dark);
    content: "+";
    font-size: var(--font-size-md);
    line-height: 1;
  }

  .mobile-collections[open] summary::after {
    content: "–";
  }

  .mobile-collections ul {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding-left: var(--space-3);
    list-style: none;
  }

  .mobile-collections a {
    display: block;
    padding: 0.35rem 0.5rem;
    margin-inline: -0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: none;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }

  .mobile-collections a:hover,
  .mobile-collections a:active,
  .mobile-collections a:focus-visible {
    background: #f7f7f7;
    color: var(--color-accent);
  }

  .mobile-collections li:last-child {
    border-top: 1px solid var(--color-border);
  }

  .mobile-collections li:last-child a {
    color: var(--color-accent-dark);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-nav);
    text-transform: uppercase;
  }

  .nav-checkbox:checked ~ .site-header__backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .nav-checkbox:checked ~ .site-header__drawer {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__drawer,
    .site-header__backdrop {
      transition:
        transform 0.22s ease,
        opacity 0.22s ease;
    }
  }

  @media (min-width: 64em) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-6);
    }

    .site-header__menu,
    .site-header__backdrop,
    .site-header__drawer {
      display: none;
    }

    .site-header__logo {
      justify-self: start;
    }

    .site-header__desktop {
      display: block;
    }

    .site-header__desktop > ul {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-5);
      list-style: none;
    }

    .site-header__desktop a {
      font-size: var(--font-size-xs);
      letter-spacing: var(--letter-spacing-nav);
      text-decoration: none;
      text-transform: uppercase;
    }

    .has-dropdown {
      position: relative;
    }

    .has-dropdown > a::after {
      display: inline-block;
      margin-left: 0.35em;
      color: var(--color-accent-dark);
      content: "▾";
      font-size: 0.65em;
    }

    .nav-dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 50;
      display: block;
      width: 260px;
      margin: 0;
      padding: 0.25rem 0;
      border: 1px solid var(--color-border);
      background: #ffffff;
      box-shadow: 0 8px 24px rgb(17 17 17 / 0.08);
      list-style: none;
      opacity: 0;
      pointer-events: none;
      transform: translateY(0.25rem);
      visibility: hidden;
    }

    .nav-dropdown li {
      list-style: none;
    }

    .nav-dropdown li::marker,
    .nav-dropdown li::before {
      content: none;
      display: none;
    }

    .nav-dropdown::before {
      position: absolute;
      top: -0.4rem;
      right: 0;
      left: 0;
      height: 0.4rem;
      content: "";
    }

    .nav-dropdown a {
      display: block;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      letter-spacing: 0.01em;
      line-height: 1.3;
      text-align: left;
      text-transform: none;
      transition:
        color 0.18s ease,
        background-color 0.18s ease;
    }

    .nav-dropdown a:hover,
    .nav-dropdown a:focus-visible {
      background: #f7f7f7;
      color: var(--color-accent);
    }

    .nav-dropdown li:last-child a {
      border-top: 1px solid var(--color-border);
      color: var(--color-accent-dark);
      font-size: var(--font-size-xs);
      letter-spacing: var(--letter-spacing-nav);
      text-transform: uppercase;
    }

    .has-dropdown:hover .nav-dropdown,
    .has-dropdown:focus-within .nav-dropdown {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      visibility: visible;
    }

    @media (prefers-reduced-motion: no-preference) {
      .nav-dropdown {
        transition:
          opacity 0.18s ease,
          transform 0.18s ease,
          visibility 0.18s ease;
      }
    }

    .site-header__desktop-only {
      display: list-item;
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('.has-dropdown').forEach((item) => {
    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const trigger = item.querySelector(':scope > a');
        trigger?.focus();
        trigger?.blur();
      }
    });
  });
</script>
