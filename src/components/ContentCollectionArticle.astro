---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ComparisonTable from './ComparisonTable.astro';
import InternalLink from './InternalLink.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PillarLayout from '../layouts/PillarLayout.astro';
import { clusterLinksFor, mergeRelatedSlugs, readingTimeMinutes } from '../lib/content-articles';
import type { ContentCollectionName } from '../types/content-article';

interface Props {
  collection: ContentCollectionName;
  entry: CollectionEntry<'guides'> | CollectionEntry<'blog'>;
}

const { collection, entry } = Astro.props;
const { Content, headings } = await render(entry);
const relatedSlugs = mergeRelatedSlugs(entry.data.relatedArticles, entry.data.slug);
const clusterLinks = clusterLinksFor(entry.data.slug);
const Layout = entry.data.isPillar ? PillarLayout : ArticleLayout;
const body = 'body' in entry ? String(entry.body ?? '') : '';
const mdxComponents = {
  ComparisonTable,
  InternalLink,
};
---

<Layout
  collection={collection}
  data={entry.data}
  headings={headings}
  readingMinutes={readingTimeMinutes(body)}
  relatedSlugs={relatedSlugs}
  clusterLinks={clusterLinks}
>
  <Content components={mdxComponents} />
</Layout>
