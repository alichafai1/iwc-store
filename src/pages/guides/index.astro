---
import EditorialIndex from '../../components/editorial/EditorialIndex.astro';
import { getEditorialPageContent, paginateEditorial } from '../../lib/editorial';

const content = getEditorialPageContent('guide');
const listing = paginateEditorial('guide', 1);
---

<EditorialIndex
  content={content}
  featured={listing.featured}
  items={listing.items}
  page={listing.page}
  totalPages={listing.totalPages}
/>
