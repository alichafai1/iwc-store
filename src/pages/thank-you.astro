---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { contactDetails } from '../data/contact';

const orderNumber = Astro.url.searchParams.get('order')?.trim() ?? '';
const title = orderNumber ? `Thank you — ${orderNumber}` : 'Thank you';
---

<BaseLayout
  title={title}
  description="Your order was received. We will contact you about payment and next steps."
  canonicalPath="/thank-you/"
  noindex
>
  <section class="thank-you">
    <div class="thank-you__card">
      <p class="thank-you__eyebrow">Order received</p>
      <h1>Thank you</h1>
      {
        orderNumber ? (
          <p class="thank-you__order">
            Order number <strong>{orderNumber}</strong>
          </p>
        ) : (
          <p class="thank-you__order">Your order has been received.</p>
        )
      }
      <p>
        We saved your order with payment status <strong>pending</strong>. Our team will contact you
        shortly with payment instructions and anything needed to complete the order.
      </p>
      <p>
        Please check your inbox and spam folder. If you need help sooner, reach us on
        <a href={contactDetails.whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        or email <a href={`mailto:${contactDetails.email}`}>{contactDetails.email}</a>.
      </p>
      <div class="thank-you__actions">
        <a class="thank-you__primary" href="/collections/">Continue shopping</a>
        <a class="thank-you__secondary" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding: 3rem 1.25rem 4rem;
    background:
      radial-gradient(circle at top, rgba(196, 160, 90, 0.12), transparent 42%),
      linear-gradient(180deg, #faf8f4 0%, #f3efe7 100%);
  }

  .thank-you__card {
    width: min(100%, 36rem);
    display: grid;
    gap: 1rem;
    padding: 2rem 1.5rem;
    border: 1px solid rgba(28, 25, 23, 0.08);
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 18px 40px rgba(28, 25, 23, 0.06);
  }

  .thank-you__eyebrow {
    margin: 0;
    color: #8a7350;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .thank-you h1 {
    margin: 0;
    font-family: var(--font-display, Georgia, 'Times New Roman', serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    color: #1c1917;
  }

  .thank-you__order,
  .thank-you p {
    margin: 0;
    color: #44403c;
    font-size: 1rem;
    line-height: 1.6;
  }

  .thank-you__order strong {
    color: #1c1917;
  }

  .thank-you a {
    color: #1c1917;
  }

  .thank-you__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .thank-you__primary,
  .thank-you__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .thank-you__primary {
    background: #b08d57;
    color: #fff;
  }

  .thank-you__secondary {
    border: 1px solid rgba(28, 25, 23, 0.16);
    color: #1c1917;
    background: transparent;
  }
</style>
