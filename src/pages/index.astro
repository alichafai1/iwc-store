---
export const prerender = false;

import BuyWithProof from '../components/home/BuyWithProof.astro';
import CollectionCarousel from '../components/home/CollectionCarousel.astro';
import CustomerReviewsSection from '../components/home/CustomerReviewsSection.astro';
import FAQSection from '../components/home/FAQSection.astro';
import Hero from '../components/home/Hero.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import ArticleCard from '../components/ui/ArticleCard.astro';
import Container from '../components/ui/Container.astro';
import TrustSection from '../components/layout/TrustSection.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { homepageFaqs } from '../data/faq';
import BaseLayout from '../layouts/BaseLayout.astro';
import { listHomepageArticles } from '../lib/editorial-listings';
import { getHomepageCatalogData } from '../lib/homepage-data';
import { defaultJsonLd, faqPageJsonLd } from '../lib/seo';

const { collections, homepageBestSellers, reviewScreenshots } = await getHomepageCatalogData();
const homepageArticles = listHomepageArticles();

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300');
---

<BaseLayout
  title="IWC Replica Watches"
  description="Shop replica IWC watches by collection: Pilot, Portugieser, Portofino, Ingenieur, and more. Compare specs and order from the catalog."
  jsonLd={[defaultJsonLd(), faqPageJsonLd(homepageFaqs)]}
>
  <div class="home">
  <Hero collections={collections} reviewScreenshots={reviewScreenshots} />

  <BuyWithProof />

  {
    collections.length > 0 ? (
      <section class="section collections-section" aria-labelledby="collections-heading">
        <Container>
          <SectionHeader headingId="collections-heading" title="Shop by Collection" align="center" />
          <CollectionCarousel
            collections={collections.map((collection) => ({
              name: collection.name,
              href: collection.href,
              image: collection.image,
              imageAlt: collection.imageAlt,
            }))}
          />
          <a class="home-view-all" href="/collections/">View all</a>
        </Container>
      </section>
    ) : null
  }

  {
    homepageBestSellers.length > 0 ? (
      <section class="section section--muted" id="best-sellers" aria-labelledby="best-sellers-heading">
        <Container>
          <SectionHeader headingId="best-sellers-heading" title="Best Sellers" align="center" />
          <div class="product-grid">
            {homepageBestSellers.map((product) => <ProductCard product={product} />)}
          </div>
          <a class="home-view-all" href="/collections/best-sellers/">View all</a>
        </Container>
      </section>
    ) : null
  }

  <HowItWorks />

  <CustomerReviewsSection items={reviewScreenshots} />

  {
    homepageArticles.length > 0 ? (
      <section class="section" aria-labelledby="editorial-heading">
        <Container>
          <SectionHeader headingId="editorial-heading" title="Blogs & Guides" href="/blog/" />
          <div class="article-grid">
            {homepageArticles.map((article) => <ArticleCard article={article} />)}
          </div>
        </Container>
      </section>
    ) : null
  }

  <FAQSection items={homepageFaqs} title="IWC Replica Watch FAQs" />

  <TrustSection />
  </div>
</BaseLayout>

<style>
  .home :global(.section) {
    padding-block: var(--space-6);
  }

  .collections-section {
    padding-top: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .product-grid,
  .article-grid {
    display: grid;
    gap: var(--space-5);
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 47.99em) {
    #best-sellers :global(.container) {
      overflow: visible;
    }

    #best-sellers .product-grid {
      gap: 0.5rem 0.3rem;
      width: calc(100% + (var(--container-gutter) * 2));
      max-width: none;
      margin-inline: calc(var(--container-gutter) * -1);
      padding-inline: 0.35rem;
    }
  }

  .home-view-all {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.5rem;
    margin: var(--space-6) 0 0 auto;
    padding: 0.65rem 1.35rem;
    border-radius: var(--radius-button);
    background: var(--color-accent);
    color: #fff;
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .home-view-all:hover {
    background: var(--color-accent-dark);
    color: #fff;
  }

  @media (max-width: 47.99em) {
    #best-sellers {
      overflow-x: clip;
    }
  }

  @media (min-width: 48em) {
    .home :global(.section) {
      padding-block: var(--space-8);
    }

    .collections-section {
      padding-top: var(--space-5);
      padding-bottom: var(--space-8);
    }

    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .home :global(.section) {
      padding-block: var(--space-10);
    }

    .collections-section {
      padding-top: var(--space-6);
      padding-bottom: 5rem;
    }

    .product-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .article-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
