---
export const prerender = false;

import ProductTemplate from '../../components/product/ProductTemplate.astro';
import { getPublishedProductPage } from '../../lib/catalog';

const slug = Astro.params.slug;

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const catalog = await getPublishedProductPage(slug);

if (!catalog) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<ProductTemplate page={catalog.page} relatedProducts={catalog.relatedProducts} />
