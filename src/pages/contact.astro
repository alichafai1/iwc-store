---
export const prerender = false;

import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Container from '../components/ui/Container.astro';
import TrustSection from '../components/layout/TrustSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_PATH, contactDetails, contactTopics } from '../data/contact';
import { absoluteUrl, breadcrumbJsonLd, defaultJsonLd } from '../lib/seo';

const title = 'Contact us';
const description =
  'WhatsApp, email, or phone for replica IWC questions: choosing a Pilot, Portugieser, or Portofino, QC approval, tracking, returns, and the one-year movement warranty.';
const presetEmail = Astro.url.searchParams.get('email')?.trim() ?? '';
const jsonLd = [
  defaultJsonLd(),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description,
    url: absoluteUrl(CONTACT_PATH),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'IWC replica store',
    url: absoluteUrl('/'),
    email: contactDetails.email,
    telephone: contactDetails.phoneTel,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: contactDetails.email,
      telephone: contactDetails.phoneDisplay,
      availableLanguage: ['English'],
    },
  },
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: title, path: CONTACT_PATH },
  ]),
];
---

<BaseLayout title={title} description={description} canonicalPath={CONTACT_PATH} jsonLd={jsonLd}>
  <header class="contact-header">
    <Container>
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: title }]} />
      <p class="eyebrow">Customer care</p>
      <h1>Contact us</h1>
      <p class="contact-header__intro">
        WhatsApp is the fastest way to reach us, day or night. Use email if you want a written thread for QC, tracking, or a return. Include the reference or order email so we can find the watch without a back-and-forth.
      </p>
    </Container>
  </header>

  <section class="section contact-channels" aria-label="Ways to reach us">
    <Container>
      <ul class="contact-channels__list">
        <li>
          <a class="contact-card" href={contactDetails.whatsappUrl} target="_blank" rel="noopener noreferrer">
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path
                  fill="currentColor"
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
            </span>
            <span class="contact-card__label">WhatsApp</span>
            <strong>{contactDetails.phoneDisplay}</strong>
            <span>Open a chat now. Replies 24/7 for size, QC, and live orders.</span>
          </a>
        </li>
        <li>
          <a class="contact-card" href={`mailto:${contactDetails.email}`}>
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <rect x="3.2" y="5.5" width="17.6" height="13" rx="1.6"></rect>
                <path d="m3.8 6.4 8.2 6.4 8.2-6.4"></path>
              </svg>
            </span>
            <span class="contact-card__label">Email</span>
            <strong>{contactDetails.email}</strong>
            <span>Best for QC clips, tracking numbers, and return requests.</span>
          </a>
        </li>
        <li>
          <a class="contact-card" href={`tel:${contactDetails.phoneTel}`}>
            <span class="contact-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M7.2 3.8h3.1l1.2 3.1-1.8 1.1a12.4 12.4 0 0 0 6.3 6.3l1.1-1.8 3.1 1.2v3.1c0 .8-.7 1.5-1.5 1.5C10.4 18.3 5.7 13.6 5.7 5.3c0-.8.7-1.5 1.5-1.5Z"></path>
              </svg>
            </span>
            <span class="contact-card__label">Phone</span>
            <strong>{contactDetails.phoneDisplay}</strong>
            <span>Call or save the number. WhatsApp uses the same line.</span>
          </a>
        </li>
      </ul>
    </Container>
  </section>

  <section class="section contact-main" aria-labelledby="contact-form-heading">
    <Container>
      <div class="contact-layout">
        <form class="contact-form" data-contact-form>
          <h2 id="contact-form-heading">Send a message</h2>
          <p>Write the note here, then open WhatsApp or your email app with it already filled in. Nothing is stored on this page.</p>

          <div class="contact-form__grid">
            <label>
              Name
              <input name="name" type="text" autocomplete="name" required maxlength="120" />
            </label>
            <label>
              Email
              <input
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="160"
                value={presetEmail}
              />
            </label>
            <label>
              Phone <span>(optional)</span>
              <input name="phone" type="tel" autocomplete="tel" maxlength="40" placeholder={contactDetails.phoneDisplay} />
            </label>
            <label>
              Order email or number <span>(optional)</span>
              <input name="order" type="text" maxlength="80" placeholder="If this is about an existing order" />
            </label>
          </div>

          <label>
            Topic
            <select name="topic" required>
              <option value="">Choose a topic</option>
              {contactTopics.map((topic) => <option value={topic.label}>{topic.label}</option>)}
            </select>
          </label>

          <label>
            Message
            <textarea name="message" required rows="7" maxlength="4000" placeholder="Reference, wrist size, or what you need from QC."></textarea>
          </label>

          <p class="contact-form__error" data-contact-error hidden></p>

          <div class="contact-form__actions">
            <button class="btn btn--accent" type="submit" data-contact-channel="whatsapp">Send on WhatsApp</button>
            <button class="btn btn--ghost" type="submit" data-contact-channel="email">Send by email</button>
          </div>
        </form>

        <aside class="contact-aside">
          <h2>Before you write</h2>
          <ul>
            <li>New order: collection, diameter, and dial. We will send the live listing.</li>
            <li>QC: reply on the thread where we sent the video, or paste the order email here.</li>
            <li>Tracking: we issue a number after you approve QC and the courier scans the parcel.</li>
          </ul>
          <p>Policies that answer most follow-ups:</p>
          <p>
            <a href="/shipping-policy/">Shipping</a>
            <a href="/returns-refunds/">Return &amp; Refund</a>
            <a href="/warranty-policy/">Warranty</a>
            <a href="/qc-videos/">QC Videos</a>
          </p>
        </aside>
      </div>
    </Container>
  </section>

  <TrustSection />
</BaseLayout>

<script>
  import { contactDetails, whatsappHref } from '../data/contact';

  function readField(form: HTMLFormElement, name: string) {
    return String(new FormData(form).get(name) ?? '').trim();
  }

  function buildBody(form: HTMLFormElement) {
    const lines = [
      `Name: ${readField(form, 'name')}`,
      `Email: ${readField(form, 'email')}`,
    ];
    const phone = readField(form, 'phone');
    const order = readField(form, 'order');
    const topic = readField(form, 'topic');
    const message = readField(form, 'message');

    if (phone) {
      lines.push(`Phone: ${phone}`);
    }
    if (order) {
      lines.push(`Order: ${order}`);
    }
    if (topic) {
      lines.push(`Topic: ${topic}`);
    }
    lines.push('', message);
    return lines.join('\n');
  }

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.hasAttribute('data-ready')) {
      return;
    }

    form.setAttribute('data-ready', '');
    const error = form.querySelector<HTMLElement>('[data-contact-error]');
    let channel = 'whatsapp';

    form.querySelectorAll<HTMLButtonElement>('[data-contact-channel]').forEach((button) => {
      button.addEventListener('click', () => {
        channel = button.dataset.contactChannel ?? 'whatsapp';
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (error) {
        error.hidden = true;
        error.textContent = '';
      }

      if (!form.reportValidity()) {
        return;
      }

      const topic = readField(form, 'topic') || 'Contact';
      const body = buildBody(form);

      try {
        if (channel === 'email') {
          const href = `mailto:${contactDetails.email}?subject=${encodeURIComponent(topic)}&body=${encodeURIComponent(body)}`;
          window.location.href = href;
          return;
        }

        window.open(whatsappHref(body), '_blank', 'noopener,noreferrer');
      } catch {
        if (error) {
          error.hidden = false;
          error.textContent = 'Your browser blocked the message window. Use the WhatsApp, email, or phone cards above.';
        }
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  .contact-header {
    padding-top: var(--space-6);
    padding-bottom: var(--space-4);
  }

  .contact-header h1 {
    margin: 0 0 var(--space-4);
  }

  .contact-header__intro {
    max-width: 42rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .contact-channels {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }

  .contact-channels__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-card {
    display: grid;
    gap: 0.45rem;
    height: 100%;
    padding: 1.25rem 1.2rem 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .contact-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
    box-shadow: 0 10px 24px rgb(17 17 11 / 6%);
    transform: translateY(-2px);
  }

  .contact-card__icon {
    display: inline-flex;
    width: 1.65rem;
    height: 1.65rem;
    margin-bottom: 0.35rem;
    color: var(--color-accent-dark);
  }

  .contact-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-card__label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-card strong {
    font-size: var(--font-size-sm);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact-card span:last-child {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .contact-main {
    padding-top: var(--space-6);
  }

  .contact-layout {
    display: grid;
    gap: var(--space-8);
  }

  .contact-form,
  .contact-aside {
    padding: 1.35rem 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-bg);
  }

  .contact-form h2,
  .contact-aside h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--font-size-md);
    font-weight: 600;
  }

  .contact-form > p,
  .contact-aside p,
  .contact-aside li {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-body);
  }

  .contact-form > p {
    margin: 0 0 var(--space-5);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .contact-form label {
    display: grid;
    gap: 0.4rem;
    margin-bottom: var(--space-4);
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: 500;
  }

  .contact-form label span {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    width: 100%;
    min-height: 2.85rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .contact-form textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--color-accent);
    outline: 2px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    outline-offset: 1px;
  }

  .contact-form__error {
    margin: 0 0 var(--space-4);
    color: #a83232;
    font-size: var(--font-size-sm);
  }

  .contact-form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact-aside ul {
    margin: 0 0 var(--space-5);
    padding-left: 1.1rem;
  }

  .contact-aside li + li {
    margin-top: var(--space-3);
  }

  .contact-aside p:last-of-type {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1rem;
    margin: 0;
  }

  .contact-aside a {
    color: var(--color-text);
    font-size: var(--font-size-sm);
    text-underline-offset: 0.18em;
  }

  .contact-aside a:hover {
    color: var(--color-accent-dark);
  }

  @media (min-width: 48em) {
    .contact-channels__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .contact-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .contact-header h1 {
      font-size: var(--font-size-2xl);
    }

    .contact-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 0.8fr);
      align-items: start;
      gap: var(--space-8);
    }

    .contact-aside {
      position: sticky;
      top: calc(var(--announce-height) + var(--header-height) + 1rem);
    }
  }
</style>
