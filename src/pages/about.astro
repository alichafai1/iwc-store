---
export const prerender = false;

import AboutPage from '../components/about/AboutPage.astro';
import { getPublishedSiteImage, getPublishedStoreCollectionCards, HOMEPAGE_HERO_SLOT } from '../lib/catalog';

const [collections, hero] = await Promise.all([
  getPublishedStoreCollectionCards(),
  getPublishedSiteImage(HOMEPAGE_HERO_SLOT),
]);
---

<AboutPage collections={collections} hero={hero} />
