---
export const prerender = false;

import AdminAppLayout from '../../../layouts/AdminAppLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import { collectionOptions } from '../../../lib/admin/collections';
import { CONTENT_STATUSES, PRODUCT_IMAGE_BUCKET } from '../../../lib/admin/constants';
import { formatAdminDate } from '../../../lib/admin/dates';
import { deleteProduct, listProducts, setProductStatus } from '../../../lib/admin/products';
import { isUuid } from '../../../lib/admin/query';
import { publicStorageUrl } from '../../../lib/admin/storage';
import { isSameOriginRequest } from '../../../lib/admin-auth';
import { createSupabaseServerClient } from '../../../lib/supabase.server';

const supabase = createSupabaseServerClient(Astro);
let flash = Astro.url.searchParams.get('saved')
  ? 'Product saved.'
  : Astro.url.searchParams.get('deleted')
    ? 'Product deleted.'
    : Astro.url.searchParams.get('updated')
      ? 'Product updated.'
      : '';
let error = Astro.url.searchParams.get('error') ?? '';

if (Astro.request.method === 'POST') {
  if (!isSameOriginRequest(Astro.request)) {
    error = 'This request could not be verified.';
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get('intent') ?? '');
    const id = String(form.get('id') ?? '');

    if (!isUuid(id)) {
      error = 'Invalid product.';
    } else {
      const { data: product } = await supabase.from('products').select('*').eq('id', id).maybeSingle();
      if (!product) {
        error = 'Product not found.';
      } else if (intent === 'delete') {
        const deleteError = await deleteProduct(supabase, id);
        if (deleteError) {
          error = deleteError;
        } else {
          return Astro.redirect('/admin/products/?deleted=1');
        }
      } else if (intent === 'publish' || intent === 'unpublish') {
        const statusError = await setProductStatus(
          supabase,
          product,
          intent === 'publish' ? 'published' : 'draft',
        );
        if (statusError) {
          error = statusError;
        } else {
          return Astro.redirect('/admin/products/?updated=1');
        }
      }
    }
  }
}

const q = Astro.url.searchParams.get('q') ?? '';
const status = Astro.url.searchParams.get('status') ?? 'all';
const collectionId = Astro.url.searchParams.get('collection') ?? '';
const { data: collections, error: collectionsError } = await collectionOptions(supabase);
const { data: products, error: listError } = await listProducts(supabase, { q, status, collectionId });
if (collectionsError) {
  error = error || collectionsError;
}
if (listError) {
  error = error || listError;
}
---

<AdminAppLayout title="Products" description="Manage store products.">
  {
    flash && (
      <p class="admin-flash admin-flash--success" role="status">
        {flash}
      </p>
    )
  }
  {
    error && (
      <p class="admin-flash admin-flash--error" role="alert">
        {error}
      </p>
    )
  }

  <form class="admin-toolbar" method="get">
    <div class="admin-toolbar__filters">
      <label class="admin-field">
        <span>Search</span>
        <input type="search" name="q" value={q} />
      </label>
      <label class="admin-field">
        <span>Status</span>
        <select name="status">
          <option value="all" selected={status === 'all'}>All</option>
          {
            CONTENT_STATUSES.map((value) => (
              <option value={value} selected={status === value}>
                {value}
              </option>
            ))
          }
        </select>
      </label>
      <label class="admin-field">
        <span>Collection</span>
        <select name="collection">
          <option value="">All collections</option>
          {
            collections.map((collection) => (
              <option value={collection.id} selected={collection.id === collectionId}>
                {collection.name}
              </option>
            ))
          }
        </select>
      </label>
      <button class="btn btn--ghost" type="submit">Filter</button>
    </div>
    <a class="btn" href="/admin/products/new/">New product</a>
  </form>

  {
    products.length === 0 ? (
      <p class="admin-empty">No products yet.</p>
    ) : (
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Title</th>
              <th>SKU</th>
              <th>Primary collection</th>
              <th>Status</th>
              <th>Featured</th>
              <th>Best seller</th>
              <th>Updated</th>
              <th class="admin-table__actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => {
              const imageUrl = publicStorageUrl(PRODUCT_IMAGE_BUCKET, product.image_path);
              const editHref = `/admin/products/${product.id}/edit/`;
              return (
                <tr>
                  <td>
                    {imageUrl ? (
                      <img class="admin-thumb" src={imageUrl} alt="" />
                    ) : (
                      <div class="admin-thumb admin-thumb--empty">None</div>
                    )}
                  </td>
                  <td>
                    <a href={editHref}>{product.title}</a>
                  </td>
                  <td>{product.sku || '—'}</td>
                  <td>{product.primary_collection_name || '—'}</td>
                  <td>
                    <StatusBadge status={product.status} />
                  </td>
                  <td>{product.featured ? 'Yes' : 'No'}</td>
                  <td>{product.best_seller ? 'Yes' : 'No'}</td>
                  <td>{formatAdminDate(product.updated_at)}</td>
                  <td class="admin-table__actions">
                    <div class="admin-actions">
                      <a class="btn btn--ghost" href={editHref}>
                        Edit
                      </a>
                      <form method="post">
                        <input type="hidden" name="id" value={product.id} />
                        <button
                          class="btn btn--ghost"
                          type="submit"
                          name="intent"
                          value={product.status === 'published' ? 'unpublish' : 'publish'}
                        >
                          {product.status === 'published' ? 'Unpublish' : 'Publish'}
                        </button>
                      </form>
                      <form method="post" data-confirm="Delete this product? This cannot be undone.">
                        <input type="hidden" name="id" value={product.id} />
                        <button class="btn btn--ghost" type="submit" name="intent" value="delete">
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )
  }
</AdminAppLayout>
