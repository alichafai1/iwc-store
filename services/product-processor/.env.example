CONTENT_AI_PROVIDER=cursor
# Exact slug from `agent models`. CURSOR_GPT_MODEL is still accepted as a fallback.
CURSOR_CONTENT_MODEL=
CURSOR_GPT_MODEL=
# Optional. Defaults to ~/.local/bin/agent
CURSOR_AGENT_BIN=
# Optional. Milliseconds per Cursor Agent CLI call.
CURSOR_CONTENT_TIMEOUT_MS=180000
CURSOR_GPT_TIMEOUT_MS=180000
# Optional fallback only. Not required when CONTENT_AI_PROVIDER=cursor.
OPENAI_API_KEY=
OPENAI_PRODUCT_MODEL=gpt-5.6-terra
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
PROCESSOR_API_KEY=generate-a-long-random-secret
PORT=8788
# Optional. Product generations at once. Keep 1–2.
PROCESSOR_CONCURRENCY=2
# Optional. Keywords sent to Stage A per model request.
KEYWORD_BATCH_SIZE=80
