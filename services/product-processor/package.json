{
  "name": "product-processor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "dev:watch": "node --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ping-cursor": "node --import tsx src/ping-cursor.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "openai": "^5.16.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
