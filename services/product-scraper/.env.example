SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SCRAPER_API_KEY=generate-a-long-random-secret
PORT=8787
# Optional. Defaults to 15000.
SCRAPER_FETCH_TIMEOUT_MS=15000
# Optional collection scrape pacing. Concurrency is capped at 3.
SCRAPER_CONCURRENCY=3
SCRAPER_DELAY_MS=450
SCRAPER_MAX_ATTEMPTS=3
